# Server Settings
FAULTWARDEN_HOST=0.0.0.0
FAULTWARDEN_PORT=8000
FAULTWARDEN_ENV=development
FAULTWARDEN_DEBUG=true
FAULTWARDEN_LOG_LEVEL=INFO

# Database Settings (PostgreSQL async)
FAULTWARDEN_DB_HOST=localhost
FAULTWARDEN_DB_PORT=5432
FAULTWARDEN_DB_USER=faultwarden
FAULTWARDEN_DB_PASSWORD=faultwarden_secret
FAULTWARDEN_DB_NAME=faultwarden
FAULTWARDEN_DB_POOL_SIZE=10
FAULTWARDEN_DB_MAX_OVERFLOW=20
FAULTWARDEN_DB_ECHO=false
# Optional full URL override (e.g. postgresql+asyncpg://user:pass@host:port/db)
# FAULTWARDEN_DATABASE_URL=

# Prometheus Settings
FAULTWARDEN_PROMETHEUS_URL=http://localhost:9090
FAULTWARDEN_PROMETHEUS_TIMEOUT_SECONDS=10.0

# Loki Settings
FAULTWARDEN_LOKI_URL=http://localhost:3100
FAULTWARDEN_LOKI_TIMEOUT_SECONDS=10.0

# LLM Provider Settings (Placeholders for future milestone)
FAULTWARDEN_LLM_PROVIDER=openai
FAULTWARDEN_LLM_MODEL=gpt-4o
FAULTWARDEN_LLM_API_KEY=
FAULTWARDEN_LLM_TEMPERATURE=0.1
FAULTWARDEN_LLM_MAX_TOKENS=4096

# Telemetry & Observability
FAULTWARDEN_OTEL_SERVICE_NAME=faultwarden
FAULTWARDEN_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
FAULTWARDEN_ENABLE_METRICS=true
